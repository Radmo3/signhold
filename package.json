{
  "name": "signhold",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "integrations/*",
    "contracts/*",
    "examples",
    "experiments/*"
  ],
  "scripts": {
    "build": "npm run build -w packages/core && npm run build -w packages/policy -w packages/sim-evm -w packages/sim-solana -w packages/reputation -w packages/sdk -w contracts/safe-guard && npm run build -w packages/api -w integrations/agentkit",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "demo": "tsx examples/demo.ts",
    "experiment:smoke": "tsx experiments/cap-bypass/src/smoke.ts",
    "experiment:run": "tsx experiments/cap-bypass/src/run.ts",
    "experiment:report": "tsx experiments/cap-bypass/src/report.ts",
    "demo:agentkit": "tsx examples/agentkit-demo.ts",
    "test:contracts": "npm run test -w contracts/safe-guard",
    "demo:safe-guard": "tsx examples/safe-guard-demo.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0"
}
