{
  "name": "@signhold/safe-guard",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "contracts/SignholdGuard.sol",
    "README.md"
  ],
  "scripts": {
    "build": "hardhat compile && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.hardhat.json",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:contracts": "hardhat test",
    "gas": "SIGNHOLD_GAS_REPORT=1 hardhat test",
    "slither": "slither . --config-file slither.config.json"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@noble/curves": "1.9.7",
    "@signhold/core": "0.2.0",
    "viem": "2.57.15"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-network-helpers": "3.0.12",
    "@nomicfoundation/hardhat-node-test-runner": "3.1.2",
    "@nomicfoundation/hardhat-viem": "3.1.0",
    "@openzeppelin/contracts": "5.6.1",
    "@safe-global/safe-smart-account": "1.5.0",
    "hardhat": "3.21.2",
    "solc": "^0.8.28"
  }
}
